APP_NAME="Sharafi Skin Care API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sharafi_skincare
DB_USERNAME=sharafi
DB_PASSWORD=
DB_SSLMODE=prefer

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000

OTP_PEPPER=
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_MOBILE_10_MINUTES=5
OTP_REQUESTS_PER_IP_10_MINUTES=20

SMS_DRIVER=null

SHOP_MAX_ITEM_QUANTITY=99
SHOP_FREE_SHIPPING_THRESHOLD_IRR=8000000
SHOP_STANDARD_SHIPPING_IRR=450000
SHOP_COURIER_SHIPPING_IRR=650000
SHOP_ORDER_RESERVATION_TTL_MINUTES=15

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
