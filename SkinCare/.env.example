APP_NAME="Sharafi Skin Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sharafi
DB_USERNAME=sharafi
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Local HTTP only. Set true in every HTTPS staging/production environment.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Include the exact Storefront/Admin hosts (with ports) that use Sanctum cookie auth.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LOCK_SECONDS=30
OTP_REQUEST_LOCK_WAIT_SECONDS=3
OTP_PEPPER=
SMS_DRIVER=null
SMS_OUTBOX_MAX_ATTEMPTS=8
SMS_OUTBOX_LOCK_TTL_SECONDS=300
SMS_NOTIFICATION_EXPIRE_HOURS=24

# SMS.ir test/production adapter. Keep SMS_DRIVER=null until secrets are configured.
SMSIR_API_KEY=
SMSIR_SANDBOX=true
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_CODE_PARAMETER=CODE
SMSIR_LINE_NUMBER=
SMSIR_CONNECT_TIMEOUT_SECONDS=3
SMSIR_TIMEOUT_SECONDS=8
SMSIR_MAX_MESSAGE_CHARS=320

PAYMENT_DRIVER=null
PAYMENT_CALLBACK_URL=${APP_URL}/api/v1/payments/zarinpal/callback
PAYMENT_RESULT_URL=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CONNECT_TIMEOUT_SECONDS=3
ZARINPAL_TIMEOUT_SECONDS=8
ZARINPAL_VERIFY_ATTEMPTS=3

SHOP_CURRENCY=IRR
SHOP_TIMEZONE=Asia/Tehran
SHOP_MAX_ITEM_QUANTITY=99
SHOP_MAX_VARIANT_PRICE_IRR=1000000000000
SHOP_FREE_SHIPPING_THRESHOLD_IRR=8000000
SHOP_STANDARD_SHIPPING_IRR=450000
SHOP_COURIER_SHIPPING_IRR=650000
SHOP_ORDER_RESERVATION_TTL_MINUTES=15
