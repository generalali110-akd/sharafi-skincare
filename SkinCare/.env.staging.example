APP_NAME="Sharafi Skin Care"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
STAGING_DOMAIN=staging.example.com
ACME_EMAIL=ops@example.com
IMAGE_TAG=staging

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr_json
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sharafi_staging
DB_USERNAME=sharafi
DB_PASSWORD=
# The bundled staging PostgreSQL is reachable only on the private Docker network.
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
FILESYSTEM_PRIVATE_SERVE=false

SANCTUM_STATEFUL_DOMAINS=staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com

OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LOCK_SECONDS=30
OTP_REQUEST_LOCK_WAIT_SECONDS=3
OTP_PEPPER=

# Staging intentionally exercises real adapters with sandbox provider modes.
SMS_DRIVER=smsir
SMS_OUTBOX_MAX_ATTEMPTS=8
SMS_OUTBOX_LOCK_TTL_SECONDS=300
SMS_OUTBOX_INITIAL_BACKOFF_SECONDS=30
SMS_OUTBOX_MAX_BACKOFF_SECONDS=3600
SMS_OUTBOX_BACKOFF_MULTIPLIER=2
SMS_NOTIFICATION_EXPIRE_HOURS=24
SMSIR_API_KEY=
SMSIR_SANDBOX=true
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_CODE_PARAMETER=CODE
SMSIR_LINE_NUMBER=
SMSIR_CONNECT_TIMEOUT_SECONDS=3
SMSIR_TIMEOUT_SECONDS=8
SMSIR_MAX_MESSAGE_CHARS=320

# Keep callback/result URLs on the same public HTTPS staging origin.
PAYMENT_DRIVER=zarinpal
PAYMENT_CALLBACK_URL=https://staging.example.com/api/v1/payments/zarinpal/callback
PAYMENT_RESULT_URL=https://staging.example.com/payment-result.html
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CONNECT_TIMEOUT_SECONDS=3
ZARINPAL_TIMEOUT_SECONDS=8
ZARINPAL_VERIFY_ATTEMPTS=3

# Runtime health thresholds used by `php artisan ops:runtime-health`.
OPS_MAX_QUEUE_BACKLOG=100
OPS_MAX_FAILED_JOBS=0
OPS_MAX_FAILED_OUTBOX=0
OPS_MAX_OUTBOX_PENDING_AGE_SECONDS=900
OPS_SCHEDULER_STALE_SECONDS=180

# Public age X25519 recipient only. Never place the private age identity in this file/server.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
BACKUP_CRON="17 2 * * *"

SHOP_CURRENCY=IRR
SHOP_TIMEZONE=Asia/Tehran
SHOP_MAX_ITEM_QUANTITY=99
SHOP_MAX_VARIANT_PRICE_IRR=1000000000000
SHOP_FREE_SHIPPING_THRESHOLD_IRR=8000000
SHOP_STANDARD_SHIPPING_IRR=450000
SHOP_COURIER_SHIPPING_IRR=650000
SHOP_ORDER_RESERVATION_TTL_MINUTES=15
