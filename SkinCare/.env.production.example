APP_NAME="Sharafi Skin Care"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.example.com
PRODUCTION_DOMAIN=shop.example.com
ACME_EMAIL=ops@example.com
# Immutable release identifier, preferably the Git commit SHA. Never use latest.
IMAGE_TAG=

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr_json
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sharafi_production
DB_USERNAME=sharafi
DB_PASSWORD=
# Database is private to the production Docker network in the bundled topology.
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Exact production host(s), without schemes, that use Sanctum cookie authentication.
SANCTUM_STATEFUL_DOMAINS=shop.example.com
# Exact HTTPS production origins. Do not use wildcards.
CORS_ALLOWED_ORIGINS=https://shop.example.com

OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LOCK_SECONDS=30
OTP_REQUEST_LOCK_WAIT_SECONDS=3
OTP_PEPPER=

SMS_DRIVER=smsir
SMS_OUTBOX_MAX_ATTEMPTS=8
SMS_OUTBOX_LOCK_TTL_SECONDS=300
SMS_OUTBOX_INITIAL_BACKOFF_SECONDS=30
SMS_OUTBOX_MAX_BACKOFF_SECONDS=3600
SMS_OUTBOX_BACKOFF_MULTIPLIER=2
SMS_NOTIFICATION_EXPIRE_HOURS=24
SMSIR_API_KEY=
SMSIR_SANDBOX=false
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_CODE_PARAMETER=CODE
SMSIR_LINE_NUMBER=
SMSIR_CONNECT_TIMEOUT_SECONDS=3
SMSIR_TIMEOUT_SECONDS=8
SMSIR_MAX_MESSAGE_CHARS=320

PAYMENT_DRIVER=zarinpal
PAYMENT_CALLBACK_URL=https://shop.example.com/api/v1/payments/zarinpal/callback
PAYMENT_RESULT_URL=https://shop.example.com/payment-result.html
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_CONNECT_TIMEOUT_SECONDS=3
ZARINPAL_TIMEOUT_SECONDS=8
ZARINPAL_VERIFY_ATTEMPTS=3

# Runtime health thresholds used by `php artisan ops:runtime-health`.
OPS_MAX_QUEUE_BACKLOG=100
OPS_MAX_FAILED_JOBS=0
OPS_MAX_FAILED_OUTBOX=0
OPS_MAX_OUTBOX_PENDING_AGE_SECONDS=900
OPS_SCHEDULER_STALE_SECONDS=180

# Public age X25519 recipient only. The private age identity belongs off-host/off-repository.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON="17 2 * * *"

SHOP_CURRENCY=IRR
SHOP_TIMEZONE=Asia/Tehran
SHOP_MAX_ITEM_QUANTITY=99
SHOP_MAX_VARIANT_PRICE_IRR=1000000000000
SHOP_FREE_SHIPPING_THRESHOLD_IRR=8000000
SHOP_STANDARD_SHIPPING_IRR=450000
SHOP_COURIER_SHIPPING_IRR=650000
SHOP_ORDER_RESERVATION_TTL_MINUTES=15
